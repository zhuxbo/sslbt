# sslbt 宝塔插件远程发布配置
# 复制为 release.conf 并填写实际值
# 重要：设置文件权限 chmod 600 release.conf

# 服务器配置
# 格式: "名称,主机,端口,目录"
SERVERS=(
    "cn,release-cn.example.com,22,/var/www/release/sslbt"
)

# SSH 认证
SSH_USER="release"
SSH_KEY="~/.ssh/release"

# 可选配置
# KEEP_VERSIONS=5
# SSH_TIMEOUT=10

# 正式 bundle 默认保存在仓库 .release-bundles/main/（已忽略但不会被脚本自动清理）。
# 若发布机有独立持久盘，执行 --prepare 时用 --bundle /absolute/durable/path/vX.Y.Z。
