# sslbt 宝塔插件远程发布配置
# 复制为 release.conf 并填写实际值
# 重要：设置文件权限 chmod 600 release.conf

# 服务器配置
# 格式: "名称,主机,端口,目录,URL"
SERVERS=(
    "cn,release-cn.example.com,22,/var/www/release/sslbt,https://release-cn.example.com/sslbt"
)

# SSH 认证
SSH_USER="release"
SSH_KEY="~/.ssh/release"

# 可选配置
# KEEP_VERSIONS=5
# SSH_TIMEOUT=10
